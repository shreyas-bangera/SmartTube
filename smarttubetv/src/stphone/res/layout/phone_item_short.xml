<?xml version="1.0" encoding="utf-8"?>
<com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_thumb_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/phone_round_thumb"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/phone_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/phone_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/phone_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phone_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout>
